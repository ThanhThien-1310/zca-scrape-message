{
    "name": "zca-scrape-message",
    "version": "1.0.0",
    "description": "Read-only Zalo Desktop message scraper (CDP-based) with scheduled and notification-triggered modes, plus a read-only MCP server over the scraped data.",
    "type": "module",
    "private": true,
    "scripts": {
        "bot:scrape": "tsx src/cli/bot-scrape.ts",
        "bot:watch": "tsx src/cli/bot-watch.ts",
        "zalo:debug": "tsx src/cli/debug/zalo.ts",
        "export:excel": "tsx src/cli/export-excel.ts",
        "mcp": "tsx src/mcp/server.ts",
        "typecheck": "tsc --noEmit",
        "sync:db": "tsx src/cli/sync-db.ts",
        "test": "node --import tsx --test \"tests/**/*.test.ts\"",
        "extract:reports": "tsx src/cli/extract-reports.ts",
        "fill:report": "tsx src/cli/fill-report.ts",
        "recover:missing": "tsx src/cli/recover-missing.ts",
        "watch:status": "tsx src/cli/watch-status.ts",
        "bot:runner": "tsx src/cli/bot-runner.ts",
        "runner:once": "tsx src/cli/runner-once.ts",
        "runner:status": "tsx src/cli/runner-status.ts",
        "runner:timing": "tsx src/cli/runner-timing.ts",
        "bot:chat": "tsx src/cli/bot-chat.ts",
        "chat:status": "tsx src/cli/chat-status.ts",
        "config:show": "tsx src/cli/config-show.ts",
        "scrape:add": "tsx src/cli/scrape-add.ts",
        "export:lesson-report": "tsx src/cli/export-lesson-report.ts",
        "mark:messages": "tsx src/cli/mark-messages.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/minesan191132/zca-scrape-message.git"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "keywords": [
        "zalo",
        "scraper",
        "cdp",
        "mcp"
    ],
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.0",
        "mssql": "^12.7.2",
        "xlsx": "^0.18.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/mssql": "^12.3.0",
        "@types/node": "^20.14.10",
        "tsx": "^4.19.0",
        "typescript": "^5.5.3"
    }
}
