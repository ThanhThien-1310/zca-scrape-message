{
    "name": "zca-scrape-message",
    "version": "1.0.0",
    "description": "Read-only Zalo Desktop message scraper (CDP-based) with scheduled and notification-triggered modes, plus a read-only MCP server over the scraped data.",
    "type": "module",
    "private": true,
    "scripts": {
        "bot:scrape": "tsx index.ts",
        "bot:watch": "tsx watch.ts",
        "zalo:debug": "tsx debug-zalo.ts",
        "export:excel": "tsx history/exportExcelCli.ts",
        "mcp": "tsx mcp/server.ts",
        "typecheck": "tsc --noEmit",
        "sync:db": "tsx syncDb.ts",
        "test": "node --import tsx --test \"tests/**/*.test.ts\"",
        "extract:reports": "tsx extractLessonReports.ts",
        "fill:report": "tsx fillRoomFacilityReport.ts",
        "recover:missing": "tsx recoverMissing.ts",
        "export:lesson-report": "tsx exportLessonReport.ts",
        "mark:messages": "tsx markMessages.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/minesan191132/zca-scrape-message.git"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "keywords": [
        "zalo",
        "scraper",
        "cdp",
        "mcp"
    ],
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.0",
        "mssql": "^12.7.2",
        "xlsx": "^0.18.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/mssql": "^12.3.0",
        "@types/node": "^20.14.10",
        "tsx": "^4.19.0",
        "typescript": "^5.5.3"
    }
}
