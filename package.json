{
    "name": "zca-scrape-message",
    "version": "1.0.0",
    "description": "Read-only Zalo Desktop message scraper (CDP-based) with scheduled and notification-triggered modes, plus a read-only MCP server over the scraped data.",
    "type": "module",
    "private": true,
    "scripts": {
        "bot:scrape": "tsx src/cli/bot-scrape.ts",
        "bot:watch": "tsx src/cli/bot-watch.ts",
        "zalo:debug": "tsx src/cli/debug/zalo.ts",
        "export:excel": "tsx src/cli/export-excel.ts",
        "mcp": "tsx src/mcp/server.ts",
        "typecheck": "tsc --noEmit",
        "sync:db": "tsx src/cli/sync-db.ts",
        "test": "node --import tsx --test \"tests/**/*.test.ts\"",
        "extract:reports": "tsx src/cli/extract-reports.ts",
        "fill:report": "tsx src/cli/fill-report.ts",
        "fill:status-reports": "tsx src/cli/fill-status-reports.ts",
        "fill:cleaning-report": "tsx src/cli/fill-cleaning-report.ts",
        "fill:attendance-report": "tsx src/cli/fill-attendance-report.ts",
        "fill:electric-report": "tsx src/cli/fill-electric-report.ts",
        "recover:missing": "tsx src/cli/recover-missing.ts",
        "watch:status": "tsx src/cli/watch-status.ts",
        "bot:runner": "tsx src/cli/bot-runner.ts",
        "runner:once": "tsx src/cli/runner-once.ts",
        "runner:status": "tsx src/cli/runner-status.ts",
        "runner:timing": "tsx src/cli/runner-timing.ts",
        "bot:chat": "tsx src/cli/bot-chat.ts",
        "chat:status": "tsx src/cli/chat-status.ts",
        "bot:total": "tsx src/cli/bot-total.ts",
        "total:once": "tsx src/cli/total-once.ts",
        "total:status": "tsx src/cli/total-status.ts",
        "config:show": "tsx src/cli/config-show.ts",
        "reports:list": "tsx src/cli/reports-list.ts",
        "skills:sync": "tsx src/cli/skills-sync.ts",
        "skills:check": "tsx src/cli/skills-check.ts",
        "scrape:add": "tsx src/cli/scrape-add.ts",
        "today": "tsx src/cli/today.ts",
        "photos:bundle": "tsx src/cli/photos-bundle.ts",
        "photos:read": "tsx src/cli/photos-read.ts",
        "photos:auto": "tsx src/cli/photos-auto.ts",
        "photos:review": "tsx src/cli/photos-review.ts",
        "fill:leave-report": "tsx src/cli/fill-leave-report.ts",
        "fill:maintenance-report": "tsx src/cli/fill-maintenance-report.ts",
        "fill:internet-speed-report": "tsx src/cli/fill-internet-speed-report.ts",
        "fill:minutes-report": "tsx src/cli/fill-minutes-report.ts",
        "leave:show": "tsx src/cli/leave-show.ts",
        "photos:golden": "tsx src/cli/photos-golden.ts",
        "export:lesson-report": "tsx src/cli/export-lesson-report.ts",
        "mark:messages": "tsx src/cli/mark-messages.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/minesan191132/zca-scrape-message.git"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "keywords": [
        "zalo",
        "scraper",
        "cdp",
        "mcp"
    ],
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.0",
        "mssql": "^12.7.2",
        "xlsx": "^0.18.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/mssql": "^12.3.0",
        "@types/node": "^20.14.10",
        "tsx": "^4.19.0",
        "typescript": "^5.5.3"
    }
}
